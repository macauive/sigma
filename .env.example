# Coinbase Advanced Trade
# API key format usually looks like: organizations/{org_id}/apiKeys/{key_id}
COINBASE_API_KEY=replace-me
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nreplace-me\n-----END EC PRIVATE KEY-----\n"

# Keep this on until you have reviewed logs and are ready for live orders.
COINBASE_DRY_RUN=1
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_GRANULARITY=FIVE_MINUTE
COINBASE_CANDLE_LIMIT=150
COINBASE_LOOP_INTERVAL_SECONDS=60

# Risk limits
COINBASE_QUOTE_TRADE_SIZE_USD=10.00
COINBASE_MAX_TRADE_SIZE_USD=25.00
COINBASE_MAX_TRADES_PER_DAY=6
COINBASE_MAX_DAILY_LOSS_USD=25.00
COINBASE_MIN_CONFIDENCE=0.62
COINBASE_FEE_BPS=80
COINBASE_SLIPPAGE_BPS=10
COINBASE_ALLOW_SELLS=0
COINBASE_SELL_BASE_SIZE=

# Paper trading
PAPER_TRADING_ENABLED=1
PAPER_TRADING_LEDGER_PATH=paper_trades.jsonl
PAPER_TRADING_STARTING_USD=1000.00
PAPER_TRADING_STARTING_BASE=0

# OpenAI advisor
ENABLE_AI_ADVISOR=1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
